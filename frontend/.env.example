# Local Vite proxy prefix forwarding to Search Admin Backend (port 8004).
VITE_ADMIN_API_BASE_URL=/admin-api

# Server-only Vite dev/preview proxy target. Never prefix with VITE_ or store secrets here.
ADMIN_BACKEND_TARGET=http://127.0.0.1:8004

# Base path for static builds (set e.g. /search-admin/ for hosted reverse-proxy deployments).
VITE_BASE_PATH=./

# Frontend authentication mode:
# - `local`: explicit local development transition mode (uses backend HttpOnly session + CSRF).
# - `bonc`: BONC host-integrated Bearer token mode (disables independent Search_Admin login).
# Production Vite builds default to `bonc` automatically. Never put tokens in VITE_* vars.
VITE_AUTH_MODE=local

# Local dev/preview ports (independent of legacy search-ai-admin on 5174/4174).
VITE_PORT=5175
VITE_PREVIEW_PORT=4175
