# =============================================================================
# Local Development Backend Template -> copy to `backend/.env`
# =============================================================================

# Runtime environment (3 supported values):
#   local       - Local dev: backend port 8004, frontend port 5175, Swagger /docs
#                 enabled, local CORS origins allowed, BONC JWT auth mandatory.
#   staging     - Staging deployment: BONC JWT auth mandatory, Swagger /docs
#                 disabled by default, explicit staging ALLOWED_ORIGINS required.
#   production  - Live deployment: BONC JWT auth mandatory, Swagger /docs
#                 disabled by default, explicit HTTPS ALLOWED_ORIGINS required.
APP_ENV=local
PORT=8004
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:4175,http://localhost:4175

# ==========================================
# AUTHENTICATION — BONC ONLY (MANDATORY)
# ==========================================
BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
# Use 0 in local testing to verify every request against BONC (immediate logout reflection).
BONC_AUTH_CACHE_SECONDS=0
# Optional HTTP timeout (seconds) for BONC getUserDetail calls (default: 5).
# BONC_AUTH_TIMEOUT=5

# ==========================================
# PLATFORM DATABASE (searchai.* TABLES ONLY)
# ==========================================
SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-local-sql-server;DATABASE=replace-with-local-platform-db;UID=replace-with-user;PWD=replace-with-password;TrustServerCertificate=yes;
SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

# Optional read-only SQL source profile for schema discovery & sync testing
# SEARCH_SOURCE_BONC_DEV=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-local-sql-server;DATABASE=replace-with-source-db;UID=replace-with-readonly-user;PWD=replace-with-password;TrustServerCertificate=yes;

# ==========================================
# PRODUCTION OBSERVABILITY (SEPARATE BOUNDARY, DISABLED LOCALLY)
# ==========================================
PRODUCTION_OBSERVABILITY_ENABLED=false
