# Local development environment template for BONC General Search Platform & Search Admin Backend.
# Copy to `backend/.env` and replace placeholder credentials.

APP_ENV=local
PORT=8004
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:4175,http://localhost:4175

# Independent General Search Platform database (searchai.* tables ONLY)
SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-local-sql-server;DATABASE=replace-with-local-platform-db;UID=replace-with-user;PWD=replace-with-password;TrustServerCertificate=yes;
SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

# Optional read-only SQL source profile for discovery & sync testing
# SEARCH_SOURCE_BONC_DEV=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-local-sql-server;DATABASE=replace-with-source-db;UID=replace-with-readonly-user;PWD=replace-with-password;TrustServerCertificate=yes;

# Local development authentication mode (`local_session` or `bonc_jwt`).
# Note: `local_session` is strictly prohibited outside APP_ENV=local.
SEARCH_ADMIN_AUTH_MODE=local_session
SEARCH_ADMIN_ALLOW_CLI_SERVICE_TOKEN=false

# Local Admin authentication (generate hash via: python -m app.services.admin_auth)
SEARCH_ADMIN_USERNAME=replace-with-local-admin-username
SEARCH_ADMIN_PASSWORD_HASH=replace-with-scrypt-hash-generated-offline
SEARCH_ADMIN_SESSION_COOKIE_NAME=bonc_search_admin_platform_session
SEARCH_ADMIN_AUTH_DB_PATH=./data/admin_auth.db
SEARCH_ADMIN_SESSION_TTL_SECONDS=28800
SEARCH_ADMIN_COOKIE_SAMESITE=lax
SEARCH_ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
SEARCH_ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
SEARCH_ADMIN_TRUST_PROXY_HEADERS=false

# Keep optional read-only production observability disabled locally
PRODUCTION_OBSERVABILITY_ENABLED=false
