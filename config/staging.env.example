# Staging environment template for BONC General Search Platform & Search Admin Backend.
# Placeholders only. Do NOT deploy without completing cutover review and security approval.
# CRITICAL: Retire the legacy port-8002 searchai.* writer before pointing Search_Admin
# at the staging searchai.* schema so there are never two concurrent writers.

APP_ENV=staging
PORT=8004
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://search-admin-staging.example.com

# Independent General Search Platform database (searchai.* tables ONLY)
SEARCH_PLATFORM_SQL_ODBC_CONNECT_STAGING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-staging-sql-server;DATABASE=RN_BoncNetwork_Staging;UID=replace-with-staging-user;PWD=replace-with-staging-password;TrustServerCertificate=yes;
SEARCH_PLATFORM_SQL_POOL_SIZE=5
SEARCH_PLATFORM_SQL_MAX_OVERFLOW=10
SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

# Reusable read-only SQL source profiles for category sync
# SEARCH_SOURCE_BONC_STAGING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-staging-sql-server;DATABASE=RN_BoncNetwork_Staging;UID=replace-with-readonly-user;PWD=replace-with-password;TrustServerCertificate=yes;

# Centralized Admin authentication — BONC is the single source of authentication.
# Local username/password login (`local_session`) is strictly prohibited outside APP_ENV=local.
# Until BONC's confirmed verification contract (public key/JWKS, shared key, or
# introspection) and Admin role mapping are supplied and configured, `bonc_jwt`
# intentionally fails closed with HTTP 503.
SEARCH_ADMIN_AUTH_MODE=bonc_jwt
SEARCH_ADMIN_ENABLE_API_DOCS=false

# Optional narrow CLI evaluation token (disabled by default; strictly backend-only;
# never usable as interactive human BONC login).
SEARCH_ADMIN_ALLOW_CLI_SERVICE_TOKEN=false
# SEARCH_ADMIN_SERVICE_TOKEN=replace-with-staging-cli-service-token

# Optional read-only Production Product & Company Search observability (disabled until Stage 3)
PRODUCTION_OBSERVABILITY_ENABLED=false
# PRODUCTION_SEARCH_BASE_URL=https://replace-with-production-origin
# PRODUCTION_SEARCH_AUTH_MODE=bearer
# PRODUCTION_SEARCH_AUTH_TOKEN=replace-with-production-observability-token

WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
