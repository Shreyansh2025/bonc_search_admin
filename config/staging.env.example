# =============================================================================
# Staging Environment Backend Template (placeholders only — do NOT deploy without approval)
# CRITICAL: Retire any legacy port-8002 searchai.* writer before pointing
# Search_Admin at staging searchai.* tables.
# =============================================================================

# Runtime environment (3 supported values):
#   local       - Local dev: Swagger /docs enabled, local CORS origins allowed.
#   staging     - Staging deployment: BONC JWT auth mandatory, Swagger /docs
#                 disabled by default, explicit staging ALLOWED_ORIGINS required.
#   production  - Live deployment: BONC JWT auth mandatory, Swagger /docs
#                 disabled by default, explicit HTTPS ALLOWED_ORIGINS required.
APP_ENV=staging
PORT=8004
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://search-admin-staging.example.com

# ==========================================
# AUTHENTICATION — BONC ONLY (MANDATORY)
# ==========================================
BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
# Positive TTL (e.g. 60s) reduces load on BONC .NET; trade-off: BONC logout/revocation
# can take up to BONC_AUTH_CACHE_SECONDS to reflect in Search Admin. Set 0 to disable.
BONC_AUTH_CACHE_SECONDS=60
BONC_AUTH_TIMEOUT=5
SEARCH_ADMIN_ENABLE_API_DOCS=false

# ==========================================
# PLATFORM DATABASE (searchai.* TABLES ONLY)
# ==========================================
SEARCH_PLATFORM_SQL_ODBC_CONNECT_STAGING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-staging-sql-server;DATABASE=RN_BoncNetwork_Staging;UID=replace-with-staging-user;PWD=replace-with-staging-password;TrustServerCertificate=yes;
SEARCH_PLATFORM_SQL_POOL_SIZE=5
SEARCH_PLATFORM_SQL_MAX_OVERFLOW=10
SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

# Optional read-only SQL source profile for category sync
# SEARCH_SOURCE_BONC_STAGING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-staging-sql-server;DATABASE=RN_BoncNetwork_Staging;UID=replace-with-readonly-user;PWD=replace-with-password;TrustServerCertificate=yes;

# ==========================================
# PRODUCTION OBSERVABILITY (SEPARATE BOUNDARY, DISABLED UNTIL STAGE 3)
# ==========================================
PRODUCTION_OBSERVABILITY_ENABLED=false
# PRODUCTION_SEARCH_BASE_URL=https://replace-with-approved-production-search-origin
# PRODUCTION_SEARCH_AUTH_MODE=bearer
# PRODUCTION_SEARCH_AUTH_TOKEN=replace-with-independent-production-observability-token
# PRODUCTION_SEARCH_AUTH_HEADER=X-API-Key
# PRODUCTION_SEARCH_TIMEOUT_SECONDS=10

WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
