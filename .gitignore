# Environment files (never commit real secrets or local overrides)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
config/*.env
!config/*.env.example

# Secrets, certificates, and private keys
*.pem
*.key
*.pfx
*.p12
*.crt

# Python
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Admin-local SQLite session store & local databases
backend/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Node / Frontend & build outputs
**/node_modules/
frontend/dist/
dist/
build/
*.tsbuildinfo
npm-debug.log*

# Logs and temporary files
*.log
logs/
tmp/
*.tmp
*.bak

# OS / Editor
.DS_Store
Thumbs.db
