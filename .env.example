# =============================================================================
# BONC General Search Platform & Search Admin — Environment Reference
# =============================================================================
# Copy backend settings into `backend/.env` (or start from `config/local.env.example`)
# and frontend settings into `frontend/.env.local` (from `frontend/.env.example`).
# Never commit real credentials or tokens.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend (`backend/.env`)
# -----------------------------------------------------------------------------

# Runtime environment (3 supported values):
#   local       - Local development (backend port 8004, frontend port 5175,
#                 Swagger /docs enabled, local dev CORS origins allowed,
#                 BONC JWT authentication mandatory).
#   staging     - Staging deployment (BONC JWT authentication mandatory,
#                 Swagger /docs disabled by default, explicit ALLOWED_ORIGINS required).
#   production  - Live deployment (BONC JWT authentication mandatory,
#                 Swagger /docs disabled by default, explicit HTTPS ALLOWED_ORIGINS required).
APP_ENV=local
PORT=8004
LOG_LEVEL=INFO

# Explicit allowed browser origins for CORS (comma-separated, never "*").
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:4175,http://localhost:4175

# ==========================================
# AUTHENTICATION — BONC ONLY (MANDATORY)
# ==========================================
# BONC .NET getUserDetail endpoint (HTTPS required outside localhost).
# Leave unset to fail closed with HTTP 503.
BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
# Comma-separated BONC roles allowed to access Search Admin (case-insensitive).
BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
# TTL (seconds) for SHA-256-keyed caching of accepted BONC tokens.
# Use 0 in local testing to verify every request against BONC (immediate logout reflection).
# In staging/production, a positive value (e.g. 60) reduces .NET load at the trade-off of
# up to that many seconds delay before a BONC logout/revocation takes effect.
BONC_AUTH_CACHE_SECONDS=0
# Optional operational timeout (seconds) for outbound HTTP calls to BONC getUserDetail.
# BONC_AUTH_TIMEOUT=5

# ==========================================
# PLATFORM DATABASE (searchai.* TABLES ONLY)
# ==========================================
# Match the suffix to APP_ENV: _LOCAL, _STAGING, or _PRODUCTION.
SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-sql-server;DATABASE=replace-with-platform-db;UID=replace-with-user;PWD=replace-with-password;TrustServerCertificate=yes;
SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

# Optional database pool / source profiles / docs / server tuning:
# SEARCH_PLATFORM_SQL_CONNECTION_STRING_LOCAL=
# SEARCH_PLATFORM_SQL_POOL_SIZE=5
# SEARCH_PLATFORM_SQL_MAX_OVERFLOW=10
# SEARCH_PLATFORM_SQL_POOL_TIMEOUT=30
# SEARCH_PLATFORM_SQL_POOL_RECYCLE=1800
# SEARCH_SOURCE_BONC_DEV=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-source-server;DATABASE=replace-with-source-db;UID=replace-with-readonly-user;PWD=replace-with-password;TrustServerCertificate=yes;
# SEARCH_ADMIN_ENABLE_API_DOCS=false
# SEARCH_LOG_SESSION_SALT=replace-with-random-salt
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=120

# ==========================================
# PRODUCTION OBSERVABILITY (SEPARATE BOUNDARY, DISABLED BY DEFAULT)
# ==========================================
# Separate backend-to-backend read-only credentials for original Production Search
# health/index observability (strictly GET-only; unrelated to BONC Admin user auth).
PRODUCTION_OBSERVABILITY_ENABLED=false
# PRODUCTION_SEARCH_BASE_URL=https://replace-with-approved-production-search-origin
# PRODUCTION_SEARCH_AUTH_MODE=bearer
# PRODUCTION_SEARCH_AUTH_TOKEN=replace-with-independent-production-observability-token
# PRODUCTION_SEARCH_AUTH_HEADER=X-API-Key
# PRODUCTION_SEARCH_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# 2. Frontend (`frontend/.env.local`)
# -----------------------------------------------------------------------------
# Browser-visible API prefix routed to Search Admin Backend via Vite proxy (dev)
# or Nginx reverse proxy (hosted). Never put secrets or tokens in VITE_* vars.
VITE_ADMIN_API_BASE_URL=/admin-api
ADMIN_BACKEND_TARGET=http://127.0.0.1:8004
VITE_BASE_PATH=./
VITE_PORT=5175
VITE_PREVIEW_PORT=4175


#  Local Backend (backend/.env)

#     # Runtime environment:
#     # - local      : Local developer workstation (Swagger /docs enabled, localhost CORS defaults)
#     # - staging    : Staging server (Swagger disabled by default, explicit ALLOWED_ORIGINS required)
#     # - production : Production server (Swagger disabled by default, explicit ALLOWED_ORIGINS required)
#     # BONC JWT authentication is mandatory in all environments.
#     APP_ENV=local
#     PORT=8004
#     LOG_LEVEL=INFO
#     ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

#     # ==========================================
#     # AUTHENTICATION — BONC ONLY
#     # ==========================================
#     BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
#     BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
#     BONC_AUTH_CACHE_SECONDS=0
#     # Optional operational tuning (defaults to 5 seconds):
#     # BONC_AUTH_TIMEOUT=5

#     # ==========================================
#     # GENERAL SEARCH PLATFORM DATABASE (SQL Server)
#     # ==========================================
#     SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=<your existing SQL Server ODBC connection string>
#     SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=false

#     # ==========================================
#     # PRODUCTION OBSERVABILITY (Separate, Read-Only, Disabled by Default)
#     # ==========================================
#     PRODUCTION_OBSERVABILITY_ENABLED=false
#   2. Local Frontend (frontend/.env.local)
#     VITE_ADMIN_API_BASE_URL=/admin-api
#     ADMIN_BACKEND_TARGET=http://127.0.0.1:8004
#     VITE_BASE_PATH=/
#     VITE_PORT=5175
#     VITE_PREVIEW_PORT=4175

#   3. Staging Backend

#   Required:

#     APP_ENV=staging
#     PORT=8004
#     ALLOWED_ORIGINS=https://<your-staging-admin-origin>

#     BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
#     BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
#     BONC_AUTH_CACHE_SECONDS=60

#     SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=<staging SQL Server ODBC connection string>
#   Optional Operational Settings:

#     LOG_LEVEL=INFO
#     BONC_AUTH_TIMEOUT=5
#     SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

#     # Separate read-only Production Search API observability (enable only if needed):
#     PRODUCTION_OBSERVABILITY_ENABLED=false
#     # PRODUCTION_SEARCH_BASE_URL=https://<production-search-api-host>
#     # PRODUCTION_SEARCH_AUTH_MODE=bearer
#     # PRODUCTION_SEARCH_AUTH_TOKEN=<read-only-service-token>
#     # PRODUCTION_SEARCH_TIMEOUT_SECONDS=5
#   4. Production Backend
#   Required:

#     APP_ENV=production
#     PORT=8004
#     ALLOWED_ORIGINS=https://<your-production-admin-origin>

#     BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
#     BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
#     BONC_AUTH_CACHE_SECONDS=60

#     SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=<production SQL Server ODBC connection string>
#   Optional Operational Settings:
#     LOG_LEVEL=INFO
#     BONC_AUTH_TIMEOUT=5
#     SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

#     # Separate read-only Production Search API observability (never reused for admin user auth):
#     PRODUCTION_OBSERVABILITY_ENABLED=false
#     # PRODUCTION_SEARCH_BASE_URL=https://<production-search-api-host>
#     # PRODUCTION_SEARCH_AUTH_MODE=bearer
#     # PRODUCTION_SEARCH_AUTH_TOKEN=<read-only-service-token>
#     # PRODUCTION_SEARCH_TIMEOUT_SECONDS=5