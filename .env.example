# =============================================================================
# BONC General Search Platform & Search Admin — Environment Example (.env.example)
# =============================================================================
# Copy backend settings into `backend/.env` and frontend settings
# into `frontend/.env.local`. Never commit real credentials/tokens.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. General Search Platform & Search Admin Backend (`backend/`)
# -----------------------------------------------------------------------------
APP_ENV=local
PORT=8004
LOG_LEVEL=INFO

# Explicit allowed browser origins for CORS (comma-separated, never "*").
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:4175,http://localhost:4175

# Independent General Search Platform SQL Server database (searchai.* tables ONLY).
# Configure the suffix matching APP_ENV (LOCAL, STAGING, PRODUCTION).
# Never point at production without DBA review and approved cutover.
SEARCH_PLATFORM_SQL_ODBC_CONNECT_LOCAL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-sql-server;DATABASE=replace-with-platform-db;UID=replace-with-user;PWD=replace-with-password;TrustServerCertificate=yes;
# Optional SQLAlchemy URL alternative:
# SEARCH_PLATFORM_SQL_CONNECTION_STRING_LOCAL=
SEARCH_PLATFORM_SQL_POOL_SIZE=5
SEARCH_PLATFORM_SQL_MAX_OVERFLOW=10
SEARCH_PLATFORM_SQL_POOL_TIMEOUT=30
SEARCH_PLATFORM_SQL_POOL_RECYCLE=1800

# Preload SentenceTransformer (all-MiniLM-L6-v2) in background on startup.
# Set false for lightweight local checks when semantic warmup is not needed immediately.
SEARCH_PLATFORM_WARMUP_EMBEDDING_MODEL=true

# Optional reusable SQL Server source profiles for schema discovery & sync.
# Profile names appear in Admin UI without ever exposing connection strings.
# SEARCH_SOURCE_BONC_DEV=DRIVER={ODBC Driver 18 for SQL Server};SERVER=replace-with-source-server;DATABASE=replace-with-source-db;UID=replace-with-readonly-user;PWD=replace-with-password;TrustServerCertificate=yes;

# Centralized Search Admin authentication (pluggable AdminAuthProvider).
# - Non-local environments (staging, production) ALWAYS default to `bonc_jwt`
#   (fail-closed HTTP 503 until BONC's confirmed verification contract & role
#   mapping are wired in) and strictly disallow `local_session`.
# - Local development supports explicit `local_session` during transition or
#   `bonc_jwt` to test fail-closed BONC mode.
SEARCH_ADMIN_AUTH_MODE=local_session

# Swagger / OpenAPI docs: enabled by default in APP_ENV=local; disabled by
# default outside local development unless explicitly enabled.
# SEARCH_ADMIN_ENABLE_API_DOCS=false

# Local-development-only session credentials (NOT usable in staging/production).
# Generate a salted scrypt hash offline from `backend/`:
#   python -m app.services.admin_auth
SEARCH_ADMIN_USERNAME=replace-with-admin-username
SEARCH_ADMIN_PASSWORD_HASH=replace-with-scrypt-hash-generated-offline

# Dedicated cookie name (local_session mode only; distinct from legacy py-backend).
SEARCH_ADMIN_SESSION_COOKIE_NAME=bonc_search_admin_platform_session

# Isolated Admin-local SQLite session & rate-limit store (local_session mode only).
SEARCH_ADMIN_AUTH_DB_PATH=./data/admin_auth.db
# Optional explicit SQLAlchemy SQLite URL override (e.g. sqlite:///:memory: for tests):
# SEARCH_ADMIN_AUTH_DB_URL=
SEARCH_ADMIN_SESSION_TTL_SECONDS=28800
# SEARCH_ADMIN_COOKIE_SECURE=true
SEARCH_ADMIN_COOKIE_SAMESITE=lax
SEARCH_ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
SEARCH_ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
SEARCH_ADMIN_TRUST_PROXY_HEADERS=false

# Optional CLI/automation service token (strictly backend-only, never sent to browsers).
# In BONC mode, disabled by default unless SEARCH_ADMIN_ALLOW_CLI_SERVICE_TOKEN=true,
# and restricted strictly to narrow CLI permissions (search execute + category read).
# NEVER use SEARCH_ADMIN_SERVICE_TOKEN as a substitute for BONC human user auth.
SEARCH_ADMIN_ALLOW_CLI_SERVICE_TOKEN=false
# SEARCH_ADMIN_SERVICE_TOKEN=replace-with-long-random-cli-service-token
# SEARCH_ADMIN_SERVICE_ACTOR=admin:service

# Optional salt for SHA-256 hashing anonymous search session cookies in SearchLogs.
# SEARCH_LOG_SESSION_SALT=replace-with-random-salt

# Optional Read-Only Production Product & Company Search Observability (Stage 3).
# MUST remain false until Stage 3 VPS deployment verification & network/auth approval.
PRODUCTION_OBSERVABILITY_ENABLED=false
# PRODUCTION_SEARCH_BASE_URL=https://replace-with-approved-production-search-origin
# PRODUCTION_SEARCH_AUTH_MODE=bearer
# PRODUCTION_SEARCH_AUTH_TOKEN=replace-with-independent-production-observability-token
# PRODUCTION_SEARCH_AUTH_HEADER=X-API-Key
# PRODUCTION_SEARCH_TIMEOUT_SECONDS=10

# Gunicorn worker tuning (keep WEB_CONCURRENCY=1 for in-memory FAISS index consistency).
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120

# -----------------------------------------------------------------------------
# 2. Search Admin Frontend (`frontend/`)
# -----------------------------------------------------------------------------
# Browser-visible API prefix routed to Search Admin Backend via Vite proxy (dev)
# or Nginx reverse proxy (hosted). Never put secrets or tokens in VITE_* vars.
VITE_ADMIN_API_BASE_URL=/admin-api
VITE_BASE_PATH=./
# Frontend authentication mode (`local` for local dev transition, `bonc` for BONC host integration).
VITE_AUTH_MODE=local
# Local Vite dev/preview ports
VITE_PORT=5175
VITE_PREVIEW_PORT=4175

# Dev-only server-side Vite proxy target (NOT prefixed with VITE_).
ADMIN_BACKEND_TARGET=http://127.0.0.1:8004
